# Runtime defaults live in env/common.env and env/<profile>.env. Put shared
# overrides in `.env` or `.env.local`, and profile-specific overrides in
# `.env.<profile>.local`.
# BULLETIN_HOST=127.0.0.1
# BULLETIN_PORT=3000
# MANAGING_APP_PUBLIC_URL=https://bulletin.example
# UI_PUBLIC_URL=http://127.0.0.1:3000
# DATABASE_PATH=bulletin.db
# BLOB_DIRECTORY=bulletin-blobs/dev
# SYNC_INTERNAL_URL=http://127.0.0.1:3001
# SYNC_PUBLIC_URL=https://bulletin.example/sync
# SYNC_HOST=127.0.0.1
# SYNC_POLL_INTERVAL_MS=10000
# MANAGING_APP_DID=did:web:bulletin.example
# SYNC_SERVICE_DID=did:web:bulletin.example
# PLC_URL=https://plc.directory
# HANDLE_RESOLVER_URL=https://public.api.bsky.app
# BSKY_URL=https://public.api.bsky.app

# Only needed while publishing Lexicons against a real PDS
# LEXICON_AUTHORITY_HANDLE=
# LEXICON_AUTHORITY_PASSWORD=
# LEXICON_AUTHORITY_PDS=
