    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "migrate": "node --import tsx scripts/migrate.ts",
    "publish-lexicons": "node --env-file=env/local.env --import tsx scripts/publish-lexicons.ts",
    "codegen:lex": "node scripts/codegen-lex.mjs",
    "test": "node --import tsx --test lib/*.test.ts lib/**/*.test.ts"
  },
