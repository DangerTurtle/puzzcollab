    "@types/react-dom": "^19.0.0",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.0.10",
    "typescript": "^5.9.3"
  },
