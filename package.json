    "@atproto/space": "alpha",
    "@atproto/syntax": "alpha",
    "@atproto/xrpc-server": "alpha",
    "better-sqlite3": "^12.5.0",
    "geist": "^1.7.2",
    "kysely": "^0.29.5",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
