# Run the app and sync worker locally against production Atmosphere accounts.
# Runtime data is kept separate from the local multi-PDS testnet.
NODE_ENV=development
PORT=3000
APP_URL=https://bulletin.dholms.at
APP_UI_URL=http://127.0.0.1:3000
DATABASE_PATH=bulletin-atmosphere.db
BLOB_DIRECTORY=bulletin-blobs/atmosphere
SYNC_URL=http://127.0.0.1:3001
SYNC_PUBLIC_URL=https://bulletin.dholms.at/sync
SYNC_POLL_INTERVAL_MS=10000
MANAGING_APP_DID=did:web:bulletin.dholms.at
SYNC_SERVICE_DID=did:web:bulletin.dholms.at
PLC_URL=https://plc.directory
HANDLE_RESOLVER_URL=https://public.api.bsky.app
BSKY_URL=https://public.api.bsky.app
