{
  "lexicon": 1,
  "id": "my.bulletin.permissions",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Bulletin",
      "detail": "Read and post on Bulletin boards",
      "permissions": [
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "my.bulletin.board",
          "authority": "*",
          "skey": "self",
          "collection": [
            "my.bulletin.post",
            "my.bulletin.label",
            "my.bulletin.position"
          ],
          "action": ["read", "create", "update", "delete"],
          "manage": ["create", "update", "delete"]
        }
      ]
    }
  }
}
